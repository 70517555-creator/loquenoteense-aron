rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esAutor(datos) {
      return conSesion() && datos.autorUid == request.auth.uid;
    }

    function fichaDelEquipo() {
      return /databases/$(database)/documents/psicologos/$(request.auth.token.email.lower());
    }

    function esPsicologo() {
      return conSesion()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(fichaDelEquipo());
    }

    function correoDeLaDuena() {
      return 'aneska2291@gmail.com';
    }

    function esLaDuenaRegistrandose(correo) {
      return conSesion()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == correoDeLaDuena()
        && correo == correoDeLaDuena()
        && nuevo().coordinador == true;
    }

    function esCoordinador() {
      return esPsicologo() && get(fichaDelEquipo()).data.coordinador == true;
    }

    function textoValido(texto, maximo) {
      return texto is string && texto.size() > 0 && texto.size() <= maximo;
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function nuevo() {
      return request.resource.data;
    }

    function sumaUnVoto(campo, rutaDelVoto) {
      return conSesion()
        && resource.data.estado == 'aprobado'
        && soloCambia([campo])
        && nuevo()[campo] == resource.data[campo] + 1
        && !exists(rutaDelVoto)
        && existsAfter(rutaDelVoto);
    }

    function votoValido(uid) {
      return conSesion() && uid == request.auth.uid
        && nuevo().keys().hasOnly(['creadoEn'])
        && nuevo().creadoEn == request.time;
    }

    function aceptoLaPolitica() {
      return nuevo().politica is string && nuevo().politica.size() > 0 && nuevo().politica.size() <= 20;
    }

    function puedeLeerPublicacion() {
      return resource.data.estado == 'aprobado' || esAutor(resource.data) || esPsicologo();
    }

    function anterior(campo) {
      return resource == null ? 0 : resource.data.get(campo, 0);
    }

    function sube(campo) {
      return nuevo().get(campo, 0) == anterior(campo) + 1;
    }

    function igual(campo) {
      return nuevo().get(campo, 0) == anterior(campo);
    }

    function sumaUnaRespuesta(carga) {
      let voto = /databases/$(database)/documents/encuesta/$(carga)/votos/$(request.auth.uid);
      let respuesta = getAfter(voto).data.respuesta;
      return conSesion()
        && nuevo().keys().hasOnly(['si', 'aveces', 'no'])
        && !exists(voto)
        && existsAfter(voto)
        && (
          (respuesta == 'si' && sube('si') && igual('aveces') && igual('no'))
          || (respuesta == 'aveces' && sube('aveces') && igual('si') && igual('no'))
          || (respuesta == 'no' && sube('no') && igual('si') && igual('aveces'))
        );
    }

    match /psicologos/{correo} {
      allow get: if conSesion() && request.auth.token.email.lower() == correo;
      allow list: if esPsicologo();
      allow create, update: if (esCoordinador() || esLaDuenaRegistrandose(correo))
        && correo == correo.lower()
        && nuevo().keys().hasOnly(['nombre', 'coordinador', 'agregadoPor'])
        && textoValido(nuevo().nombre, 80)
        && nuevo().coordinador is bool;
      allow delete: if esCoordinador() && correo != request.auth.token.email.lower() && correo != correoDeLaDuena();
    }

    match /temas/{fecha} {
      allow read: if true;
      allow create: if esPsicologo()
        && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && nuevo().fecha == fecha
        && nuevo().keys().hasOnly(['titulo', 'descripcion', 'fecha', 'creadoPor', 'creadoEn'])
        && textoValido(nuevo().titulo, 120)
        && nuevo().descripcion is string && nuevo().descripcion.size() <= 400;
      allow delete: if esPsicologo();

      match /comentarios/{id} {
        allow read: if puedeLeerPublicacion();

        allow create: if conSesion()
          && nuevo().keys().hasOnly(['texto', 'apodo', 'rol', 'estado', 'urgente', 'meAyudo', 'autorUid', 'creadoEn', 'temaTitulo', 'respondeA', 'politica'])
          && textoValido(nuevo().texto, 800)
          && textoValido(nuevo().apodo, 80)
          && textoValido(nuevo().temaTitulo, 120)
          && nuevo().autorUid == request.auth.uid
          && nuevo().urgente is bool
          && nuevo().meAyudo == 0
          && nuevo().creadoEn == request.time
          && (
            (nuevo().rol == 'padre' && nuevo().estado == 'pendiente' && !('respondeA' in nuevo()) && aceptoLaPolitica())
            || (nuevo().rol == 'psicologia' && nuevo().estado == 'aprobado' && esPsicologo())
          );

        allow update: if (esPsicologo() && soloCambia(['estado', 'motivoRechazo']) && nuevo().estado in ['aprobado', 'rechazado'])
          || sumaUnVoto('meAyudo', /databases/$(database)/documents/temas/$(fecha)/comentarios/$(id)/votos/$(request.auth.uid));

        allow delete: if esPsicologo();

        match /votos/{uid} {
          allow get: if conSesion() && uid == request.auth.uid;
          allow create: if votoValido(uid);
        }
      }
    }

    match /{ruta=**}/comentarios/{id} {
      allow read: if esPsicologo();
    }

    match /propuestas/{id} {
      allow read: if puedeLeerPublicacion();

      allow create: if conSesion()
        && nuevo().keys().hasOnly(['texto', 'nivel', 'autorUid', 'estado', 'votos', 'creadoEn', 'politica'])
        && textoValido(nuevo().texto, 200)
        && (!('nivel' in nuevo()) || textoValido(nuevo().nivel, 60))
        && nuevo().autorUid == request.auth.uid
        && nuevo().estado == 'pendiente'
        && nuevo().votos == 0
        && aceptoLaPolitica()
        && nuevo().creadoEn == request.time;

      allow update: if (esPsicologo() && soloCambia(['estado', 'motivoRechazo', 'fechaProgramada']))
        || sumaUnVoto('votos', /databases/$(database)/documents/propuestas/$(id)/votos/$(request.auth.uid));

      allow delete: if esPsicologo();

      match /votos/{uid} {
        allow get: if conSesion() && uid == request.auth.uid;
        allow create: if votoValido(uid);
      }
    }

    match /cartas/{id} {
      allow read: if puedeLeerPublicacion();

      allow create: if conSesion()
        && nuevo().keys().hasOnly(['carga', 'texto', 'nivel', 'urgente', 'autorUid', 'estado', 'meHizoPensar', 'creadoEn', 'politica'])
        && textoValido(nuevo().texto, 800)
        && textoValido(nuevo().carga, 30)
        && textoValido(nuevo().nivel, 40)
        && nuevo().urgente is bool
        && nuevo().autorUid == request.auth.uid
        && nuevo().estado == 'pendiente'
        && nuevo().meHizoPensar == 0
        && aceptoLaPolitica()
        && nuevo().creadoEn == request.time;

      allow update: if (esPsicologo() && soloCambia(['estado', 'motivoRechazo']) && nuevo().estado in ['aprobado', 'rechazado'])
        || sumaUnVoto('meHizoPensar', /databases/$(database)/documents/cartas/$(id)/votos/$(request.auth.uid));

      allow delete: if esPsicologo();

      match /votos/{uid} {
        allow get: if conSesion() && uid == request.auth.uid;
        allow create: if votoValido(uid);
      }
    }

    match /encuesta/{carga} {
      allow read: if true;
      allow create, update: if carga.matches('^[a-z-]{1,30}$') && sumaUnaRespuesta(carga);

      match /votos/{uid} {
        allow get: if conSesion() && uid == request.auth.uid;
        allow create: if conSesion() && uid == request.auth.uid
          && nuevo().keys().hasOnly(['respuesta', 'creadoEn'])
          && nuevo().respuesta in ['si', 'aveces', 'no']
          && nuevo().creadoEn == request.time;
      }
    }

    match /reportes/{id} {
      allow create: if conSesion()
        && nuevo().keys().hasOnly(['ruta', 'texto', 'motivo', 'autorUid', 'creadoEn'])
        && textoValido(nuevo().ruta, 300)
        && textoValido(nuevo().texto, 800)
        && textoValido(nuevo().motivo, 120)
        && nuevo().autorUid == request.auth.uid
        && nuevo().creadoEn == request.time;
      allow read, delete: if esPsicologo();
    }
  }
}
